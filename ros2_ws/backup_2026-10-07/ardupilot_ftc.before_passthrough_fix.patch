index 7ebad14768..e5b9d7a023 100644
--- a/libraries/AP_Motors/AP_MotorsMatrix.cpp
+++ b/libraries/AP_Motors/AP_MotorsMatrix.cpp
@@ -212,6 +212,11 @@ float AP_MotorsMatrix::boost_ratio(float boost_value, float normal_value) const
 // includes new scaling stability patch
 void AP_MotorsMatrix::output_armed_stabilizing()
 {
+    if (single_motor_failure_mode_active()) {
+        output_armed_stabilizing_single_motor_failure();
+        return;
+    }
+
     // apply voltage and air pressure compensation
     const float compensation_gain = thr_lin.get_compensation_gain(); // compensation for battery voltage and altitude
 
@@ -401,6 +406,220 @@ void AP_MotorsMatrix::output_armed_stabilizing()
 
     // check for failed motor
     check_for_failed_motor(throttle_thrust_best_plus_adj);
+
+    update_complete_loss_detector();
+}
+
+// complete loss of one rotor on a quad: the attitude controller pins that motor at full output and its diagonal
+// partner (same spin direction, opposite roll / pitch factors) at minimum. Declared after 30 ms of that pattern.
+void AP_MotorsMatrix::update_complete_loss_detector()
+{
+    uint8_t n = 0;
+    int8_t k = -1;
+    float t_high = -1.0f;
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        if (motor_enabled[i]) {
+            n++;
+            if (_thrust_rpyt_out[i] > t_high) {
+                t_high = _thrust_rpyt_out[i];
+                k = i;
+            }
+        }
+    }
+    int8_t j = -1;
+    if (n == 4 && k >= 0) {
+        float best = 0.0f;
+        for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+            const float dot = _roll_factor[i] * _roll_factor[k] + _pitch_factor[i] * _pitch_factor[k];
+            if (motor_enabled[i] && i != k && dot < best) {
+                best = dot;
+                j = i;
+            }
+        }
+    }
+    if (j >= 0 && t_high >= 0.95f && _thrust_rpyt_out[j] <= 0.05f) {
+        _cl_count = (k == _cl_candidate) ? _cl_count + 1 : 1;
+        _cl_candidate = k;
+    } else {
+        _cl_count = 0;
+    }
+    _cl_motor = (_cl_count >= MAX(1U, (uint16_t)(0.03f / MAX(_dt_s, 0.0005f)))) ? _cl_candidate : -1;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Single-motor-failure (SMF) allocation for fault-tolerant control of a quad.
+// Following the decoupled degraded strategy of Gu, Wang and Lu (IEEE Access 13, 2025, "Fault-Tolerant Control of a
+// Quadrotor UAV With Single Rotor Failure in Dense Obstacle Environments"): yaw is given up and the three remaining
+// rotors produce the collective thrust and the roll / pitch torques exactly (3 equations, 3 unknowns).
+// The request comes from the FTC custom controller every loop and expires after 200 ms.
+
+void AP_MotorsMatrix::request_single_motor_failure_mode(int8_t motor_index, float opposite_thrust)
+{
+    _smf_opposite_thrust = opposite_thrust;
+    if (motor_index < 0 || motor_index >= AP_MOTORS_MAX_NUM_MOTORS || !motor_enabled[motor_index]) {
+        _smf_index = -1;
+        return;
+    }
+    _smf_index = motor_index;
+    _smf_last_ms = AP_HAL::millis();
+}
+
+bool AP_MotorsMatrix::get_single_motor_failure_realized(float &roll, float &pitch) const
+{
+    if (!single_motor_failure_mode_active()) {
+        return false;
+    }
+    roll = _smf_realized_roll;
+    pitch = _smf_realized_pitch;
+    return true;
+}
+
+bool AP_MotorsMatrix::single_motor_failure_mode_active() const
+{
+    return _smf_index >= 0 && (AP_HAL::millis() - _smf_last_ms) < 200;
+}
+
+void AP_MotorsMatrix::output_armed_stabilizing_single_motor_failure()
+{
+    const float compensation_gain = thr_lin.get_compensation_gain();
+    const float roll_thrust = (_roll_in + _roll_in_ff) * compensation_gain;
+    const float pitch_thrust = (_pitch_in + _pitch_in_ff) * compensation_gain;
+    float throttle_thrust = constrain_float(get_throttle() * compensation_gain, 0.0f, 1.0f);
+
+    // the healthy motors, and the torque scale of the normal mixer (torque per unit roll / pitch input)
+    uint8_t idx[3];
+    uint8_t n_ok = 0, n_enabled = 0;
+    float sum_r2 = 0.0f, sum_p2 = 0.0f;
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        if (!motor_enabled[i]) {
+            continue;
+        }
+        n_enabled++;
+        sum_r2 += sq(_roll_factor[i]);
+        sum_p2 += sq(_pitch_factor[i]);
+        if (i != _smf_index && n_ok < 3) {
+            idx[n_ok++] = i;
+        }
+    }
+    // A t = b with rows (collective, roll torque, pitch torque) over the three healthy motors
+    const Matrix3f A(1.0f, 1.0f, 1.0f,
+                     _roll_factor[idx[0]], _roll_factor[idx[1]], _roll_factor[idx[2]],
+                     _pitch_factor[idx[0]], _pitch_factor[idx[1]], _pitch_factor[idx[2]]);
+    Matrix3f Ainv;
+    if (n_enabled != 4 || n_ok != 3 || !A.inverse(Ainv)) {
+        // only defined for a quad; fall back to the normal mixer
+        _smf_index = -1;
+        output_armed_stabilizing();
+        return;
+    }
+    // thrust per unit of total collective (h), and the roll / pitch part (g); torque per unit input as in the
+    // normal mixer, so the attitude controllers see the same plant gain
+    const Vector3f h = Ainv * Vector3f(1.0f, 0.0f, 0.0f);
+    Vector3f g = Ainv * Vector3f(0.0f, roll_thrust * sum_r2, pitch_thrust * sum_p2);
+    const float c_des = n_enabled * throttle_thrust;  // same total thrust as the four-motor mixer would give
+
+    // keep 0 <= g + c h <= 1: roll / pitch first, collective clamped to what fits, torque scaled down if nothing fits
+    float scale = 1.0f, c_lo = 0.0f, c_hi = 0.0f;
+    for (uint8_t iter = 0; iter < 12; iter++) {
+        c_lo = 0.0f;
+        c_hi = n_enabled;
+        for (uint8_t j = 0; j < 3; j++) {
+            const float gj = g[j] * scale;
+            if (h[j] > 1.0e-4f) {
+                c_lo = MAX(c_lo, -gj / h[j]);
+                c_hi = MIN(c_hi, (1.0f - gj) / h[j]);
+            } else if (gj > 1.0f) {  // motor with no collective share (opposite the failed one): torque too large
+                c_hi = -1.0f;
+            }
+        }
+        if (c_lo <= c_hi) {
+            break;
+        }
+        scale *= 0.8f;
+    }
+    float c = constrain_float(c_des, c_lo, MAX(c_lo, c_hi));
+
+    // yaw brake (relaxed hover, Mueller and D'Andrea 2016): the rotor opposite the failed one spins the other way, so
+    // giving it thrust t_o opposes the spin. The remaining pair is then allocated by weighted least squares on
+    // (collective, roll, pitch); the torque residual is fixed in the spinning body frame and is absorbed by the
+    // reduced attitude loop.
+    int8_t j_opp = -1;
+    for (uint8_t j = 0; j < 3; j++) {
+        if (h[j] <= 1.0e-4f) {
+            j_opp = j;
+        }
+    }
+    bool full_thrusts = false;
+    if (is_positive(_smf_opposite_thrust) && j_opp >= 0) {
+        const float t_o = constrain_float(_smf_opposite_thrust, 0.0f, 1.0f);
+        uint8_t ab[2];
+        uint8_t k = 0;
+        for (uint8_t j = 0; j < 3; j++) {
+            if (j != j_opp) {
+                ab[k++] = j;
+            }
+        }
+        const float w_c = 10.0f;  // weight of the collective row relative to the torque rows
+        const float bc = c_des - t_o;
+        const float br = roll_thrust * sum_r2 - _roll_factor[idx[j_opp]] * t_o;
+        const float bp = pitch_thrust * sum_p2 - _pitch_factor[idx[j_opp]] * t_o;
+        const float a0r = _roll_factor[idx[ab[0]]], a1r = _roll_factor[idx[ab[1]]];
+        const float a0p = _pitch_factor[idx[ab[0]]], a1p = _pitch_factor[idx[ab[1]]];
+        // normal equations of the weighted 3x2 system
+        const float m00 = w_c * w_c + a0r * a0r + a0p * a0p;
+        const float m01 = w_c * w_c + a0r * a1r + a0p * a1p;
+        const float m11 = w_c * w_c + a1r * a1r + a1p * a1p;
+        const float r0 = w_c * w_c * bc + a0r * br + a0p * bp;
+        const float r1 = w_c * w_c * bc + a1r * br + a1p * bp;
+        const float det = m00 * m11 - m01 * m01;
+        if (fabsf(det) > 1.0e-6f) {
+            float ta = (m11 * r0 - m01 * r1) / det;
+            float tb = (m00 * r1 - m01 * r0) / det;
+            // keep the pair inside 0..1 by shifting both together (gives up collective first), then clip
+            const float hi = MAX(ta, tb), lo = MIN(ta, tb);
+            if (hi > 1.0f) {
+                ta -= hi - 1.0f;
+                tb -= hi - 1.0f;
+                limit.throttle_upper = true;
+            } else if (lo < 0.0f) {
+                ta -= lo;
+                tb -= lo;
+            }
+            g.zero();
+            scale = 1.0f;
+            g[ab[0]] = constrain_float(ta, 0.0f, 1.0f);
+            g[ab[1]] = constrain_float(tb, 0.0f, 1.0f);
+            g[j_opp] = t_o;
+            c = 0.0f;
+            full_thrusts = true;
+        }
+    }
+    if (scale < 1.0f) {
+        limit.set_rpy(true);
+    }
+    if (full_thrusts) {
+        // limits were set by the least-squares branch
+    } else if (c < c_des) {
+        limit.throttle_upper = true;
+    } else if (c > c_des) {
+        limit.throttle_lower = true;
+    }
+    limit.yaw = true;  // yaw is not controlled in this mode
+
+    _thrust_rpyt_out[_smf_index] = 0.0f;
+    for (uint8_t j = 0; j < 3; j++) {
+        _thrust_rpyt_out[idx[j]] = constrain_float(g[j] * scale + c * h[j], 0.0f, 1.0f);
+    }
+    _throttle_out = (full_thrusts ? (g[0] + g[1] + g[2]) / n_enabled : c / n_enabled) / compensation_gain;
+
+    // torque actually produced, in mixer-input units (the normal mixer gives sum(f_i^2) per unit input)
+    float rr = 0.0f, pp = 0.0f;
+    for (uint8_t j = 0; j < 3; j++) {
+        rr += _roll_factor[idx[j]] * _thrust_rpyt_out[idx[j]];
+        pp += _pitch_factor[idx[j]] * _thrust_rpyt_out[idx[j]];
+    }
+    _smf_realized_roll = rr / (sum_r2 * compensation_gain);
+    _smf_realized_pitch = pp / (sum_p2 * compensation_gain);
 }
 
 // check for failed motor
